{
  "network": {
    "interface": "wlan0",
    "host": "127.0.0.1",
    "port": 8080
  },
  "environment": {
    "binaries": [
      "nmap",
      "iw",
      "wpa-supplicant",
      "pixiewps",
      "net-tools"
    ],
    "libraries": [
      "requests",
      "psutil"
    ],
    "lib_paths": [],
    "python_path": ""
  },
  "permissions": {
    "check_method": "auto",
    "strict_mode": true
  },
  "modules": {
    "root_required_commands": [
      "wps_attack",
      "connect_with_password",
      "auto_connect",
      "scan",
      "clear_all",
      "quit"
    ]
  },
  "server": {
    "max_clients": 1,
    "ws_ping_interval": 20,
    "ws_ping_timeout": 60
  }
}