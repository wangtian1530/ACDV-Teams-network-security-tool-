* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    font-family: 'Segoe UI', 'Courier New', monospace;
    min-height: 100vh;
    padding: 20px;
}
.container { max-width: 1400px; margin: 0 auto; }
.header { text-align: center; color: #2b2a2a; margin-bottom: 25px; border-radius: 10px;border: dotted;}
.header h1 { font-size: 2em; text-shadow: 2px 2px 4px rgba(0,0,0,0.3); }
.header p { opacity: 0.9; margin-top: 8px; }
.terminal-container {
    background: #1e1e2e;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    overflow: hidden;
    margin-bottom: 20px;
}
.terminal-header {
    background: #2d2d3a;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #4a4a5a;
    flex-wrap: wrap;
    gap: 10px;
    display: none;
}
.terminal-buttons { display: flex; gap: 8px; }
.terminal-btn { width: 12px; height: 12px; border-radius: 50%; }
.terminal-btn.red { background: #ff5f56; }
.terminal-btn.yellow { background: #ffbd2e; }
.terminal-btn.green { background: #27c93f; }
.terminal-title { color: #a9b7c6; font-size: 12px; flex: 1; }
.ws-status {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #1e1e2e;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-family: monospace;
}
.ws-status .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}
.ws-status .status-dot.connecting { background: #ffc107; animation: pulse 1.5s infinite; }
.ws-status .status-dot.connected { background: #28a745; }
.ws-status .status-dot.disconnected { background: #dc3545; }
.ws-status .status-text { color: #a9b7c6; }
@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
}
.clear-btn {
    background: none;
    border: 1px solid #4a4a5a;
    color: #a9b7c6;
    cursor: pointer;
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 4px;
    transition: all 0.3s;
}
.clear-btn:hover:not(:disabled) { background: #4a4a5a; color: white; }
.clear-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.terminal-content {
    background: #1e1e2e;
    height: 350px;
    overflow-y: auto;
    padding: 15px;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    color: #d4d4d4;
}
.terminal-content::-webkit-scrollbar { width: 8px; }
.terminal-content::-webkit-scrollbar-track { background: #2d2d3a; }
.terminal-content::-webkit-scrollbar-thumb { background: #4a4a5a; border-radius: 4px; }
.log-line {
    padding: 2px 0;
    white-space: pre-wrap;
    word-break: break-all;
    border-left: 2px solid transparent;
    font-family: monospace;
    animation: fadeIn 0.2s ease;
}
.log-line:hover { background: rgba(255,255,255,0.05); border-left-color: #667eea; }
.log-line.system-log { color: #6a9955; }
.log-line.error-log { color: #f48771; }
.log-line.cmd-log { color: #dcdcaa; }
.log-line.loading {
    color: #ffc107;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.log-line.loading .spinner {
    width: 12px;
    height: 12px;
    border: 2px solid #ffc107;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    display: inline-block;
}
@keyframes fadeIn { from { opacity: 0; transform: translateY(-2px); } to { opacity: 1; transform: translateY(0); } }
@keyframes spin { to { transform: rotate(360deg); } }

/* ========== NETWORK & LAN DEVICES ========== */
.network-list, .lan-list {
    background: #f4f4f4;
    border-radius: 8px;
    margin: 0px 0;
    border: 1px solid #e0e0e0;
    overflow: hidden;
}
.network-header, .lan-header {
    background: #e9ecef;
    padding: 12px;
    font-weight: bold;
    display: grid;
    gap: 10px;
    border-bottom: 2px solid #dee2e6;
    font-size: 12px;
}
.network-header { grid-template-columns: 50px 1fr 150px 80px; }
.lan-header { grid-template-columns: 130px 1fr 100px; }
.network-item, .lan-item {
    padding: 12px;
    border-bottom: 1px solid #e0e0e0;
    cursor: pointer;
    transition: all 0.2s;
    display: grid;
    gap: 10px;
    align-items: center;
}
.network-item { grid-template-columns: 50px 1fr 150px 80px; }
.lan-item { grid-template-columns: 130px 1fr 100px; }
.network-item:hover:not(.disabled-item) { background: #e9ecef; }
.lan-item:hover { background: #e9ecef; }
.network-item.selected { background: #d4edda; border-left: 3px solid #28a745; }
.network-item.disabled-item { opacity: 0.5; cursor: not-allowed; coler: red;}
.lan-item {
    cursor: pointer;
}
.lan-item.clickable {
    cursor: pointer;
}
.lan-device-ip {
    font-family: monospace;
    font-weight: bold;
    color: #0066cc;
}
.lan-device-ports {
    font-size: 11px;
    color: #666;
    margin-top: 4px;
}
.lan-port-badge {
    display: inline-block;
    background: #17a2b8;
    color: white;
    padding: 2px 6px;
    border-radius: 10px;
    font-size: 10px;
    margin: 2px 3px;
}
.lan-os-guess {
    font-size: 11px;
    color: #28a745;
    margin-top: 2px;
}
.wps-badge {
    display: inline-block;
    padding: 2px 8px;
    background: #ffc107;
    color: #333;
    font-size: 11px;
    border-radius: 12px;
    font-weight: bold;
}
.saved-badge {
    display: inline-block;
    padding: 2px 8px;
    background: #28a745;
    color: white;
    font-size: 11px;
    border-radius: 12px;
    font-weight: bold;
}
.lan-badge {
    display: inline-block;
    padding: 2px 8px;
    background: #17a2b8;
    color: white;
    font-size: 10px;
    border-radius: 12px;
}

/* ========== PHẦN LỖ HỔNG BẢO MẬT ========== */
.vulnerability-section, .password-suggestion-section {
    background: white;
    border-radius: 12px;
    margin-bottom: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    overflow: hidden;
    animation: slideDown 0.3s ease;
}
@keyframes slideDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
}
.vuln-header, .suggestion-header {
    background: linear-gradient(135deg, #2c3e50 0%, #1a1a2e 100%);
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: white;
}
.vuln-header h2, .suggestion-header h2 {
    font-size: 1.2em;
    margin: 0;
}
.close-vuln, .close-suggestion {
    background: none;
    border: none;
    color: white;
    font-size: 28px;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.3s;
}
.close-vuln:hover, .close-suggestion:hover { opacity: 1; }
.vuln-content, .suggestion-content { padding: 20px; }
.vuln-summary {
    background: #f8f9fa;
    border-radius: 10px;
    padding: 15px;
    margin-bottom: 20px;
    border-left: 4px solid #dc3545;
}
.vuln-badge {
    display: inline-block;
    padding: 5px 15px;
    border-radius: 20px;
    font-weight: bold;
    font-size: 12px;
    margin-bottom: 12px;
}
.badge-wps { background: #ffc107; color: #333; }
.badge-critical { background: #dc3545; color: white; }
.badge-password { background: #17a2b8; color: white; }
.vuln-network, .vuln-password {
    margin: 8px 0;
    font-size: 14px;
}
.vuln-password code {
    background: #1e1e2e;
    color: #ffc107;
    padding: 4px 8px;
    border-radius: 6px;
    font-family: monospace;
    font-size: 13px;
}
.strength-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 11px;
    margin-left: 8px;
    font-weight: bold;
}
.strength-yếu { background: #dc3545; color: white; }
.strength-trung-bình { background: #ffc107; color: #333; }
.strength-mạnh { background: #28a745; color: white; }
.strength-rất-mạnh { background: #20c997; color: white; }
.vuln-list h3, .recommendations h3 {
    font-size: 1em;
    margin: 20px 0 12px 0;
    color: #2c3e50;
    border-bottom: 2px solid #e0e0e0;
    padding-bottom: 5px;
}
.vuln-item {
    background: #fff3cd;
    border-left: 4px solid #ffc107;
    padding: 12px 15px;
    margin-bottom: 12px;
    border-radius: 8px;
}
.vuln-item.severity-cao, .vuln-item.severity-rất-cao {
    background: #f8d7da;
    border-left-color: #dc3545;
}
.vuln-item.severity-nghiêm-trọng {
    background: #f5c6cb;
    border-left-color: #721c24;
}
.vuln-item-title {
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 6px;
    color: #856404;
}
.severity-cao .vuln-item-title, .severity-rất-cao .vuln-item-title {
    color: #721c24;
}
.vuln-item-desc, .vuln-item-details {
    font-size: 13px;
    margin: 4px 0;
    color: #333;
}
.vuln-item-details {
    color: #666;
    font-style: italic;
}
.vuln-severity {
    font-size: 11px;
    margin-top: 8px;
    font-weight: bold;
}
.rec-item {
    background: #d1ecf1;
    border-left: 4px solid #17a2b8;
    padding: 12px 15px;
    margin-bottom: 12px;
    border-radius: 8px;
}
.rec-title {
    font-weight: bold;
    font-size: 14px;
    margin-bottom: 6px;
    color: #0c5460;
}
.rec-desc {
    font-size: 13px;
    color: #333;
}

/* ========== PHẦN ĐỀ XUẤT MẬT KHẨU ========== */
.suggestion-intro {
    background: #e7f3ff;
    padding: 12px 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 14px;
}
.suggestion-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 20px;
}
.suggestion-item {
    background: #f8f9fa;
    border-radius: 10px;
    padding: 15px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    border: 1px solid #e0e0e0;
    transition: transform 0.2s;
}
.suggestion-item:hover { transform: translateX(5px); background: #fff; }
.suggestion-number {
    width: 35px;
    height: 35px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 16px;
}
.suggestion-password {
    flex: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}
.suggestion-password code {
    background: #1e1e2e;
    color: #ffc107;
    padding: 8px 12px;
    border-radius: 8px;
    font-family: monospace;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 1px;
}
.copy-suggestion-btn {
    background: #6c757d;
    color: white;
    border: none;
    padding: 5px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 11px;
    transition: background 0.3s;
}
.copy-suggestion-btn:hover { background: #5a6268; }
.suggestion-strength {
    font-size: 12px;
    font-weight: bold;
    padding: 4px 10px;
    border-radius: 20px;
}
.suggestion-tips {
    background: #e8f5e9;
    border-radius: 10px;
    padding: 15px;
    margin-top: 10px;
}
.suggestion-tips h4 {
    margin-bottom: 10px;
    color: #2e7d32;
}
.suggestion-tips ul {
    margin-left: 20px;
    color: #333;
    font-size: 13px;
}
.suggestion-tips li {
    margin: 5px 0;
}
.copy-toast {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: #28a745;
    color: white;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    animation: fadeInOut 2s ease;
    z-index: 1000;
}
@keyframes fadeInOut {
    0% { opacity: 0; transform: translateY(20px); }
    15% { opacity: 1; transform: translateY(0); }
    85% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(20px); }
}
.button-panel {
    background: #e7e7ff;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}
.button-grid {
    display: flex;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 3px;
    margin-bottom: 18px;
}
.btn {
    padding: 12px 20px;
    border: none;
    border-radius: 8px;
    font-family: monospace;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
}
.btn-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
.btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(102,126,234,0.4); }
.btn-danger { background: #dc3545; color: white; }
.btn-danger:hover:not(:disabled) { background: #c82333; transform: translateY(-2px); }
.btn-warning { background: #ffc107; color: #333; }
.btn-warning:hover:not(:disabled) { background: #e0a800; transform: translateY(-2px); }
.btn-success { background: #28a745; color: white; }
.btn-success:hover:not(:disabled) { background: #218838; transform: translateY(-2px); }
.btn-secondary { background: #6c757d; color: white; }
.btn-secondary:hover:not(:disabled) { background: #5a6268; transform: translateY(-2px); }
.btn-info { background: #17a2b8; color: white; }
.btn-info:hover:not(:disabled) { background: #138496; transform: translateY(-2px); }
.btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none !important; }
.input-group {
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid #e0e0e0;
}
.input-group label { display: block; margin-bottom: 8px; font-weight: bold; color: #333; }
.input-group input {
    width: 100px;
    padding: 2px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-family: monospace;
    font-size: 10px;
}
.input-group input:disabled { background: #f5f5f5; cursor: not-allowed; }
.input-group input:focus { outline: none; border-color: #667eea; }
.flex-row { display: flex; gap: 10px; flex-wrap: inherit; }
.flex-row input { flex: 1; min-width: 142px; }
.status-bar {
    background: #e9ecef;
    color: #495057;
    padding: 10px 15px;
    border-radius: 8px;
    margin-top: 15px;
    font-size: 12px;
    text-align: center;
}
.hint-text { font-size: 11px; color: #28a745; margin-top: 5px; }
.hint-text.warning { color: #ffc107; }
@media (max-width: 768px) {
    body { padding: 10px; }
    .terminal-content { height: 70px; font-size: 10px; }
    .network-header, .network-item {
        grid-template-columns: 40px 1fr 100px 60px;
        font-size: 10px;
        gap: 5px;
    }
    .lan-header, .lan-item {
        grid-template-columns: 100px 1fr 80px;
        font-size: 10px;
        gap: 5px;
    }
    .btn { padding: 10px 1px; font-size: 10px; }
    .ws-status { font-size: 9px; padding: 2px 8px; }
    .suggestion-item { flex-direction: column; align-items: flex-start; }
    .suggestion-password { width: 100%; }
}


